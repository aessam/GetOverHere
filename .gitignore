# Xcode
*.xcuserstate
xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Claude
.claude/

# Local review input
/Review-22Aug26.md

# Android local build cache
Android/.gradle/
Android/local.properties

# The wrapper is required by clean checkouts, even when a global rule ignores JARs.
!Android/gradle/wrapper/gradle-wrapper.jar

# This repository owns its cross-platform Swift package. Override the global
# macOS Packages/ ignore so protocol sources and tests stay tracked.
!Packages/
!Packages/TourSessionCore/
!Packages/TourSessionCore/**
Packages/TourSessionCore/.build/
Packages/TourSessionCore/.swiftpm/

# Local gateway security and test-fixture package build products.
Packages/LocalLinkSecurity/.build/
Packages/LocalLinkSecurity/.swiftpm/
Packages/GatewayTLSFixture/.build/
Packages/GatewayTLSFixture/.swiftpm/

# Preserve the resolved graph for the new TLS dependency and the app consuming it.
!Packages/LocalLinkSecurity/Package.resolved
!Packages/GatewayTLSFixture/Package.resolved
!iOS/GetOverHere.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Sanitized, bounded verification logs are evidence, not disposable build output.
!benchmarks/2026-09-11-gateway-software/**/*.log
