<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth connects nearby tour rooms and carries tour audio and controls when Wi-Fi is unavailable. Your location is not shared.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>GetOverHere uses your local network to discover nearby channels and stream audio directly between devices without a backend.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location stays on this device and is used only to show your position, distance, and direction relative to the guide's shared pin.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_goh-hub._tcp</string>
		<string>_goh-audio._tcp</string>
		<string>_goh-peer._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan the companion phone's public pairing QR code to verify the wired connection.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>GetOverHere needs microphone access to broadcast audio to nearby devices on your local network.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>WiFiAwareServices</key>
	<dict>
		<key>_goh-tour._tcp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
		<key>_goh-probe._udp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aens.getoverhere.tour</string>
			<key>UTTypeDescription</key>
			<string>GetOverHere Tour</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gohtour</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.getoverhere.tour</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GetOverHere Tour</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.aens.getoverhere.tour</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
